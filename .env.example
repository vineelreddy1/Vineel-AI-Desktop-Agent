# Vineel Assistant Environment Configuration Example

OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# LLM Options: openai, gemini, mock
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o-mini

# Speech to Text Options: speech_recognition, whisper, mock
STT_PROVIDER=speech_recognition
STT_LANGUAGE=en-US
STT_LISTEN_TIMEOUT=5
STT_PHRASE_TIME_LIMIT=8

# Text to Speech Options: pyttsx3, edge_tts, mock
TTS_PROVIDER=pyttsx3
TTS_VOICE=
TTS_RATE=175

# Wake Word Settings
WAKE_WORD_ENABLED=true
WAKE_WORD=hey vineel
